{
  "name": "@lxagents-mcp/shared-instruction",
  "version": "5.0.0",
  "description": "Read-only MCP server that delivers the LXAgents shared agent instruction set — branch strategy, commit conventions, rules, creators — plus a registry of the sibling instruction and security servers.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "lxagents-shared-instruction": "src/index.js"
  },
  "files": [
    "src",
    "content",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node src/index.js",
    "start:stdio": "node src/index.js",
    "start:http": "node src/http.js",
    "test": "node --test",
    "inspect": "npx @modelcontextprotocol/inspector node src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "LXAgents",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LXAgents-MCP/shared-instruction.git"
  },
  "homepage": "https://github.com/LXAgents-MCP/shared-instruction#readme",
  "bugs": {
    "url": "https://github.com/LXAgents-MCP/shared-instruction/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agents",
    "agent-instructions",
    "lxagents",
    "connector",
    "sse",
    "http"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  }
}
