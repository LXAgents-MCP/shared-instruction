{
  "name": "@lxagents/agents-base",
  "version": "0.6.1",
  "description": "MCP server that delivers the LXAgents shared agent instruction set — AGENTS-SETUP and the base rules — over prompts and resources, so a repository consumes it through a connector instead of cloning it.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "lxagents-agents": "src/cli/index.js",
    "lxagents-agents-base": "src/index.js"
  },
  "files": [
    "src",
    "content",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node src/index.js",
    "cli": "node src/cli/index.js",
    "start:http": "MCP_TRANSPORT=http node src/index.js",
    "start:stdio": "MCP_TRANSPORT=stdio node src/index.js",
    "dev": "MCP_TRANSPORT=http node --watch src/index.js",
    "test": "node --test",
    "inspect": "npx @modelcontextprotocol/inspector node src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "LXAgents",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LXAgents-MCP/shared-instruction.git"
  },
  "homepage": "https://github.com/LXAgents-MCP/shared-instruction#readme",
  "bugs": {
    "url": "https://github.com/LXAgents-MCP/shared-instruction/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agents",
    "agent-instructions",
    "lxagents",
    "connector"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  }
}
